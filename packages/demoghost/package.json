{
  "name": "demoghost",
  "version": "1.0.0",
  "description": "Your UI. On autopilot. Turn your UI into its own demo.",
  "main": "./dist/demoghost.cjs",
  "module": "./dist/demoghost.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/demoghost.min.js",
  "jsdelivr": "./dist/demoghost.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/demoghost.js",
      "require": "./dist/demoghost.cjs",
      "default": "./dist/demoghost.js"
    },
    "./css": "./dist/demoghost.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/*.css"
  ],
  "devDependencies": {
    "@demoghostjs/core": "workspace:*",
    "@demoghostjs/recorder": "workspace:*",
    "@demoghostjs/controls": "workspace:*"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "product-demo",
    "interactive-demo",
    "javascript-demo",
    "ui-demo",
    "website-demo",
    "product-tour",
    "demo-library",
    "browser-demo",
    "interactive-walkthrough",
    "ui-automation",
    "frontend",
    "typescript"
  ],
  "author": "DemoGhost Team",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irontoreofficial/demoghost.git",
    "directory": "packages/demoghost"
  },
  "bugs": {
    "url": "https://github.com/irontoreofficial/demoghost/issues"
  },
  "homepage": "https://irontoreofficial.github.io/demoghost/"
}
