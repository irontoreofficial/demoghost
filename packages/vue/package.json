{
  "name": "@demoghostjs/vue",
  "version": "1.0.2",
  "description": "Official Vue 3 adapter for DemoGhost",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "demoghost": "^1.0.0"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "vue": "^3.5.13"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "author": "DemoGhost Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
