{
  "name": "demoghost-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Your UI. On autopilot. Turn your UI into its own demo.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irontoreofficial/demoghost.git"
  },
  "homepage": "https://demoghost.dev",
  "bugs": {
    "url": "https://github.com/irontoreofficial/demoghost/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "pnpm -r --filter=\"./packages/*\" --filter=\"./apps/*\" run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint \"packages/**/*.{ts,tsx}\" \"apps/**/*.{ts,tsx}\" \"examples/**/*.{ts,tsx}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css,md,html}\"",
    "dev": "pnpm --filter demoghost-docs dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitest/coverage-v8": "^3.0.5",
    "axe-core": "^4.10.2",
    "eslint": "^9.20.1",
    "happy-dom": "^17.1.3",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.0.5"
  }
}
